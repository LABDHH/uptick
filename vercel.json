{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install && npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{agents.py,budget.py,cache.py,demo_data.py,discovery.py,explain.py,graph.py,metrics.py,prompts.py,relevance.py,schemas.py,youtube.py,web/dist/**}",
      "excludeFiles": "{tests/**,web/node_modules/**,web/src/**,.venv/**,**/*.db,**/*.db-shm,**/*.db-wal,streamlit_version_archive.zip}"
    }
  },
  "env": {
    "UPTICK_DB": "/tmp/uptick.db",
    "UPTICK_CHECKPOINTS": "/tmp/checkpoints.db"
  }
}
