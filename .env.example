# Copy to .env and fill in. .env is gitignored.
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
GEMINI_API_KEY=your-gemini-api-key

# Monthly Gemini spend this app may use, in USD. New searches pause when the
# remaining budget cannot cover one more average search. Unset = no app limit
# (Google's own spend cap still applies).
UPTICK_MONTHLY_BUDGET_USD=1
# Optional: share of the cap searches may use (default 0.9).
# UPTICK_BUDGET_HEADROOM=0.9
# Optional: assumed cost of one search until 3 have been measured (default 0.20).
# UPTICK_EST_RUN_USD=0.20
# Optional: once one search has spent this much, its remaining calls run on
# Flash-Lite (default 0.25).
# UPTICK_MAX_RUN_USD=0.25
# Optional: searches allowed per browser session (default 5).
# UPTICK_SESSION_CAP=5

# Optional: model ids, if Google renames them.
# UPTICK_MODEL_FLASH=gemini-3.8-flash
# UPTICK_MODEL_LITE=gemini-3.5-flash-lite
# Optional: price overrides, USD per 1M tokens [input, output], and per
# grounded Google Search query past the free monthly allowance (5,000 queries,
# shared by every Gemini 3+ model on the Google project).
# UPTICK_PRICES={"gemini-3.8-flash": [1.50, 7.50], "gemini-3.5-flash-lite": [0.30, 2.50]}
# UPTICK_PRICE_GROUNDED_QUERY=0.014
# UPTICK_FREE_GROUNDED_QUERIES=5000

# Production on Vercel: add the Upstash Redis integration, which sets these.
# Without them the monthly total lives in /tmp and resets on cold start.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: discovery and relevance tuning.
# UPTICK_MAX_SEARCHES=3          # YouTube search calls per brief (100/day project-wide)
# UPTICK_MAX_CANDIDATES=24       # creators studied in depth per brief
# UPTICK_TRENDING_PAGES=2        # pages of 50 per trending chart (1 unit each)
# UPTICK_COMMENT_VIDEOS=2        # videos per creator whose comments are read (1 unit each)
# UPTICK_MIN_RELEVANCE=0.30      # judged relevance below this is excluded as off-brief
# UPTICK_SHORTLIST_TARGET=10     # widen the search one level up when fewer clear the bar
# UPTICK_FILL_MIN_SCORE=35       # lowest score a labelled "Broader fit" pick may have
# UPTICK_WIDEN=1                 # 0 turns the one-level-up second pass off
# UPTICK_WIDEN_CANDIDATES=16     # creators studied in the widened pass
